# Copia este archivo como ".env" y pon tu clave real. Nunca subas .env a git.
ANTHROPIC_API_KEY=sk-ant-...

# Opcionales
MODELO=claude-opus-5-5
# Tipo de cambio para mostrar costos en pesos chilenos
DOLAR_CLP=950
# 1 = si el modelo rechaza una solicitud, se reintenta con el modelo de respaldo recomendado
USAR_RESPALDO=1
# 1 = modo demostración: no llama a la IA, usa respuestas simuladas para las fotos de /ejemplos
MODO_DEMO=0
# Carpeta donde se guardan la base de datos y los Excel
DATOS_DIR=datos
