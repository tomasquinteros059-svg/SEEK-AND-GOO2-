# Reparto · variables de entorno (copia este archivo como .env.local; nunca subas valores reales).
# Ninguna de estas es secreta salvo las marcadas con [SECRETO]: esas van solo en los
# secretos de GitHub, EAS o Supabase, jamás en el código ni en el chat.

# --- App móvil (Expo) ---
APP_NOMBRE=Reparto                 # nombre visible (provisorio)
APP_ID=cl.reparto.app              # identificador en las tiendas: se fija antes de la primera publicación
EAS_PROJECT_ID=                    # expo.dev → tu proyecto → Project ID
EXPO_OWNER=                        # tu usuario u organización de Expo
EXPO_PUBLIC_SENTRY_DSN=            # Sentry → proyecto reparto-movil → Client Keys (DSN)
EXPO_PUBLIC_ENTORNO=desarrollo
EXPO_PUBLIC_SUPABASE_URL=          # Supabase → Project Settings → API → Project URL
EXPO_PUBLIC_SUPABASE_ANON_KEY=     # la clave "anon"/"publishable" (pública por diseño: la seguridad está en RLS)
EXPO_PUBLIC_URL_PANEL=             # dirección del panel web, para abrir los Términos desde la app

# --- Panel web (Next.js) ---
NEXT_PUBLIC_APP_NOMBRE=Reparto
NEXT_PUBLIC_SENTRY_DSN=            # Sentry → proyecto reparto-web → DSN
NEXT_PUBLIC_ENTORNO=desarrollo
NEXT_PUBLIC_SUPABASE_URL=          # Supabase → Project Settings → API 
NEXT_PUBLIC_SUPABASE_ANON_KEY=     # ídem, la clave "anon"/"publishable" (pública por diseño)
NEXT_PUBLIC_URL_PANEL=             # dirección pública del panel (aparece en el correo de invitación)
GEOCODER=                          # simulado | nominatim | google (por omisión: google si hay clave, si no nominatim)
GOOGLE_GEOCODING_KEY=              # [SECRETO] Google Cloud → Geocoding API (~10.000 gratis al mes)
NOMINATIM_URL=                     # el Nominatim propio del VPS (Fase 8). Vacío = el público, solo para poco volumen
CORREO_CONTACTO=                   # va en la identificación que pide Nominatim
NEXT_PUBLIC_MAPA_ESTILO=           # estilo del mapa. Vacío = OpenFreeMap (gratis, desarrollo); "vacio" = sin internet (pruebas)
RESEND_API_KEY=                    # [SECRETO] para enviar las invitaciones por correo (opcional en desarrollo)
CORREO_REMITENTE=                  # ejemplo: Reparto <avisos@tudominio.cl>

# --- Solo en la CI ---
# EXPO_TOKEN=                [SECRETO] expo.dev → Account settings → Access tokens
# SENTRY_AUTH_TOKEN=         [SECRETO] para subir mapas de código
# SUPABASE_ACCESS_TOKEN=     [SECRETO] supabase.com → Account → Access Tokens
# SUPABASE_DB_PASSWORD=      [SECRETO] la contraseña de la base del proyecto de desarrollo
